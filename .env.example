# On VM1, orchestrator services connect to local NATS.
NATS_URL=nats://127.0.0.1:4222

# Managed nodes publish to VM1's reachable IP. Used by Ansible playbooks/scripts.
TELEMETRY_NATS_URL=nats://192.168.122.88:4222

DATABASE_PATH=./data/cluster_state.db
ANSIBLE_INVENTORY=./ansible/inventory.ini
ANSIBLE_CONFIG=./ansible/ansible.cfg
TELEMETRY_INTERVAL_SECONDS=5
NODE_ID=
NODE_TYPE=
NODE_ROLE=worker
# LLM provider: set GEMINI_API_KEY for Gemini, or OPENAI_API_KEY for OpenAI
# Copy this file to .env and fill in your API key — .env is gitignored.
LLM_PROVIDER=gemini
LLM_MODEL=gemini/gemma-4-31b-it
# GEMINI_API_KEY=
# OPENAI_API_KEY=
