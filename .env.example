# On VM1, orchestrator services connect to local NATS.
NATS_URL=nats://127.0.0.1:4222

# Managed nodes publish to VM1's reachable IP. Used by Ansible playbooks/scripts.
TELEMETRY_NATS_URL=nats://192.168.122.88:4222

DATABASE_PATH=./data/cluster_state.db
ANSIBLE_INVENTORY=./ansible/inventory.ini
ANSIBLE_CONFIG=./ansible/ansible.cfg
TELEMETRY_INTERVAL_SECONDS=5
NODE_ID=
NODE_TYPE=
NODE_ROLE=worker
# Shared secret used to authorize tasks between the orchestrator and child agents.
# Must be identical on the orchestrator and every managed node running a child agent.
CHILD_AUTH_SECRET=
# Local database used by a child agent for its own task history.
CHILD_DATABASE_PATH=./data/child_state.db
# How often a child agent publishes agent.<node_id>.heartbeat.
CHILD_HEARTBEAT_INTERVAL_SECONDS=15

# Option B NATS credentials. Use separate least-privilege credentials per node.
NATS_USER=
NATS_PASSWORD=
NATS_CREDS_FILE=
# Local NATS server authentication (used by scripts/start_nats_local.sh when enabled).
NATS_AUTH_REQUIRED=false
NATS_ORCHESTRATOR_USER=
NATS_ORCHESTRATOR_PASSWORD=
# JSON map of node_id to {user,password}; prefer NATS_CHILD_CREDENTIALS_FILE for secrets.
NATS_CHILD_CREDENTIALS_JSON=
NATS_CHILD_CREDENTIALS_FILE=
CHILD_NATS_USER=
CHILD_NATS_PASSWORD=
CHILD_NATS_CREDS_FILE=
ORCHESTRATOR_NODE_ID=vm1
# LLM provider: set GEMINI_API_KEY for Gemini, or OPENAI_API_KEY for OpenAI
# Copy this file to .env and fill in your API key — .env is gitignored.
LLM_PROVIDER=gemini
LLM_MODEL=gemini/gemma-4-31b-it
# GEMINI_API_KEY=
# OPENAI_API_KEY=
