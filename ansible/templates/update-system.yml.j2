---
- hosts: {{ target }}
  gather_facts: true
  become: yes
  tasks:
    - name: Update all packages (apt)
      ansible.builtin.apt:
        upgrade: dist
        update_cache: yes
      when: ansible_facts['pkg_mgr'] == 'apt' or ansible_pkg_mgr == 'apt'

    - name: Update all packages (apk)
      community.general.apk:
        upgrade: yes
        update_cache: yes
      when: ansible_facts['pkg_mgr'] == 'apk' or ansible_pkg_mgr == 'apk'


