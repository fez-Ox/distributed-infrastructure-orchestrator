[Unit]
Description=MAO authenticated NATS server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=orchestrator
WorkingDirectory=/home/orchestrator/multi-agent-orchestration
ExecStart=/home/orchestrator/multi-agent-orchestration/.local/bin/nats-server -c /home/orchestrator/multi-agent-orchestration/data/nats-server.conf
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
